#Contains HTTP requests used to test API endpoints directly in VS Code.#

#api call for signup
###
POST http://127.0.0.1:8000/account/register/
Content-Type: application/json

{
    "username":"django",
    "password":"django@123",
    "email":"django@gmail.com",
    "phone":123456,
    "dob":"2005-03-02"
}

#=========TOKEN==========
###
POST http://127.0.0.1:8000/token/
Content-Type: application/json

{
    "username":"django",
    "password":"django@123"
}

#api call for listing expenses
###
GET  http://127.0.0.1:8000/expenses/
Accept: application/json
Authorization:Token bf4d9de2d2ce9f90e141db8ad7ddc71653633d16

#api call for creating expense
###
POST http://127.0.0.1:8000/expenses/
Content-Type: application/json
Authorization:Token bf4d9de2d2ce9f90e141db8ad7ddc71653633d16

{
    "title":"fuel",
    "category":"travel",
    "amount":500
}

#api cal for fetching expense
###
GET  http://127.0.0.1:8000/expenses/2/
Accept: application/json
Authorization:Token bf4d9de2d2ce9f90e141db8ad7ddc71653633d16

#api cal for fetching expense
###
PUT   http://127.0.0.1:8000/expenses/2/
Content-Type: application/json
Authorization:Token bf4d9de2d2ce9f90e141db8ad7ddc71653633d16

{
  "id": 2,
  "title": "dinner",
  "category": "food",
  "amount": "350.00",
  "description": null,
  "bill_image": null,
  "payment_method": "upi",
  "created_at": "2026-11-16T04:14:39.868282Z",
  "owner": 1
}

#api call for deleting data
###
DELETE http://127.0.0.1:8000/expenses/1/
Accept: application/json
Authorization:Token bf4d9de2d2ce9f90e141db8ad7ddc71653633d16

#api call summary
###
GET http://127.0.0.1:8000/expenses/summery/
Accept: application/json
Authorization:Token bf4d9de2d2ce9f90e141db8ad7ddc71653633d16
